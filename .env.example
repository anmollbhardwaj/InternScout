# InternScout Environment Variables

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/internscout

# AI / LLM Configuration (Set provider to 'gemini' or 'openai')
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Alternatively for OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# Internshala Account & Credentials
INTERNSHALA_EMAIL=your_internshala_email@example.com
INTERNSHALA_PASSWORD=your_secure_password_here
INTERNSHALA_BASE_URL=https://internshala.com

# Automation & Browser Engine
HEADLESS_BROWSER=true
MIN_MATCH_THRESHOLD=75
HOURLY_DELTA_INTERVAL_MINUTES=60
DAILY_DEEP_SYNC_HOUR=2

# Anti-Detection Jitter Delays (seconds)
SCRAPE_MIN_DELAY_SEC=2.0
SCRAPE_MAX_DELAY_SEC=5.5
ACTION_TIMEOUT_MS=30000
